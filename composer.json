{
  "name": "chubvladislav/api-autopilot-stripe-legacy-fixture",
  "description": "Deliberately outdated Stripe PaymentIntent API fixture for API Autopilot testing",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "stripe/stripe-php": "^10.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "LegacyCheckout\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LegacyCheckout\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  }
}
